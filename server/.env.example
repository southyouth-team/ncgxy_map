NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=ncgxy_campus_map
DB_SSL=false
DB_LOGGING=false

# 开发环境默认自动执行未应用的 TypeORM migration；生产环境默认 false，由发布流程执行 npm run db:migrate
# 如需覆盖默认策略，可显式设置 true 或 false
# DB_MIGRATIONS_RUN=true

# 开发环境请求头 X-Dev-User-Id 用于模拟登录身份；生产环境会拒绝此模式。

# 本地底图文件存储目录；生产环境请挂载持久化磁盘卷
ASSET_STORAGE_DIR=./uploads
